{
  "manifest_version": 3,
  "name": "CounterString",
  "version": "0.4.3",
  "description": "CounterString and text generation for Exploratory Testing",
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "Open CounterString Floating Dialog",
    "default_icon": {
      "16": "icons/icon16x16.png",
      "32": "icons/icon32x32.png"
    }
  },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16x16.png",
    "48": "icons/icon48x48.png",
    "128": "icons/icon128x128.png"
  }
}
